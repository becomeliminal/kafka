def kafka(name:str, version:str, scala_version:str="2.13", hashes:list=[], visibility:list=[]):
    """
    Downloads Apache Kafka distribution.

    Usage:
        kafka(name = "kafka", version = "3.9.1", visibility = ["PUBLIC"])

    Access:
        //third_party/binary:kafka - full kafka directory containing bin/ and libs/

    The bin/ scripts use relative paths to libs/, so both must stay together.

    Args:
        name (str): Name of the rule.
        version (str): Kafka version (e.g., "3.9.1").
        scala_version (str): Scala version. Defaults to "2.13".
        hashes (list): Optional hashes to verify download.
        visibility (list): Visibility declaration.
    """
    kafka_dir = f"kafka_{scala_version}-{version}"
    url = f"https://downloads.apache.org/kafka/{version}/{kafka_dir}.tgz"

    download = remote_file(
        name = tag(name, "download"),
        url = url,
        hashes = hashes,
    )

    # Single output - whole directory
    # Avoids RBE deadlock from filegroup referencing same target twice
    build_rule(
        name = name,
        srcs = [download],
        outs = [kafka_dir],
        cmd = "tar -xzf $SRC",
        binary = True,
        visibility = visibility,
        building_description = f"Extracting Kafka v{version}...",
    )
